# Copy to .env and fill in. Never commit .env (it is in .gitignore).

PORT=3000

# Municipality staff sign-in at /admin. Use a long random value.
ADMIN_TOKEN=

# Claude API key for the AI functions (server-side only, never sent to the browser).
# Without it the app still runs: reports wait for 2 confirmations or the
# municipality, and recommendations/rankings use simple rules.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Demo mode: shows made-up demo accounts on the sign-in screen and lets the
# app use a location in Elbasan instead of GPS (for demos outside Elbasan).
DEMO_MODE=false

# Web push (optional). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Where data and photos are stored (default: data/db.json and data/uploads/)
# DATA_FILE=data/db.json
